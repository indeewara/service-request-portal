PORT=4000
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
# Local-only value. Use a long random secret from a secrets manager in any real environment.
JWT_SECRET=local-dev-secret-change-me
# S3 (LocalStack locally). S3_PUBLIC_ENDPOINT is the host browsers use for pre-signed URLs.
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=service-request-photos
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
REDIS_URL=redis://localhost:6379
# Mock email provider: delivers to Mailpit (inbox at http://localhost:8025) and fails this share of calls on purpose.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Service Portal <no-reply@portal.local>
MOCK_EMAIL_FAILURE_RATE=0.3
# First retry delay; doubles on each attempt (5 attempts).
NOTIFICATION_BACKOFF_MS=2000
LOG_LEVEL=info
# Login attempts per minute per client IP.
LOGIN_RATE_LIMIT=5
# Proxies in front of the API (1 behind the Next.js server, 2 behind ALB + Next.js).
TRUST_PROXY_HOPS=0
